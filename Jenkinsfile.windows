// Jenkins installed on Windows (bat). Linux agents: use "Jenkinsfile".
pipeline {
    agent any

    parameters {
        choice(name: 'TARGET_ENV', choices: ['dev', 'prod'], description: 'Which environment to deploy')
    }

    environment {
        IMAGE       = "thirudocker004/live-poll"
        CREDS       = credentials('dockerhub-creds')      // username + password (Docker Hub)
        ADMIN_TOKEN = credentials('poll-admin-token')     // Secret text -> becomes env var ADMIN_TOKEN
    }

    options { timestamps() }

    stages {
        stage('Checkout') {
            steps { checkout scm }
        }

        // Environment-specific values live HERE, in one place. The image stays identical.
        stage('Select Config') {
            steps {
                script {
                    if (params.TARGET_ENV == 'prod') {
                        env.HOST_PORT     = '4001'
                        env.APP_ENV       = 'prod'
                        env.LOG_LEVEL     = 'info'
                        env.POLL_QUESTION = 'Which language should the team standardize on?'
                        env.POLL_OPTIONS  = 'Node.js,Python,Go,Java'
                    } else {
                        env.HOST_PORT     = '4000'
                        env.APP_ENV       = 'dev'
                        env.LOG_LEVEL     = 'debug'
                        env.POLL_QUESTION = 'Dev test: which language do you prefer?'
                        env.POLL_OPTIONS  = 'Node.js,Python,Go'
                    }
                    echo "Target=${params.TARGET_ENV} port=${env.HOST_PORT} log=${env.LOG_LEVEL}"
                }
            }
        }

        stage('Unit Tests') {
            steps { bat 'docker build --target test -t %IMAGE%:test-%BUILD_NUMBER% .' }
        }

        stage('Build') {
            steps {
                bat 'docker build --build-arg BUILD_NUMBER=%BUILD_NUMBER% -t %IMAGE%:%BUILD_NUMBER% -t %IMAGE%:latest .'
            }
        }

        stage('Smoke Test') {
            steps {
                bat '''
                    docker rm -f smoke-%BUILD_NUMBER% >nul 2>&1
                    docker run -d --name smoke-%BUILD_NUMBER% -e ADMIN_TOKEN=smoke-test-token -e APP_ENV=smoke %IMAGE%:%BUILD_NUMBER%
                    if errorlevel 1 exit /b 1
                    set /a TRIES=0

                    :retry
                    docker exec smoke-%BUILD_NUMBER% wget -q --spider http://localhost:3000/health
                    if not errorlevel 1 goto ok
                    set /a TRIES+=1
                    if %TRIES% GEQ 10 goto fail
                    ping -n 3 127.0.0.1 >nul
                    goto retry

                    :ok
                    docker exec smoke-%BUILD_NUMBER% wget -qO- http://localhost:3000/config | findstr /C:"smoke-test-token" >nul
                    if not errorlevel 1 goto leak
                    echo Health check passed, no secret in /config
                    exit /b 0

                    :leak
                    echo SECRET LEAKED in /config
                    exit /b 1

                    :fail
                    echo Health check failed
                    docker logs smoke-%BUILD_NUMBER%
                    exit /b 1
                '''
            }
            post { always { bat returnStatus: true, script: 'docker rm -f smoke-%BUILD_NUMBER%' } }
        }

        stage('Push') {
            steps {
                bat '''
                    echo %CREDS_PSW%| docker login -u %CREDS_USR% --password-stdin
                    if errorlevel 1 exit /b 1
                    docker push --quiet %IMAGE%:%BUILD_NUMBER%
                    if errorlevel 1 exit /b 1
                    docker push --quiet %IMAGE%:latest
                '''
            }
        }

        stage('Approve Production') {
            when { expression { params.TARGET_ENV == 'prod' } }
            steps { input message: 'Deploy to PRODUCTION?', ok: 'Deploy' }
        }

        stage('Deploy') {
            steps {
                // "-e ADMIN_TOKEN" (no value) makes Docker copy it from Jenkins' environment,
                // so the secret is never written into the command line or the log.
                bat '''
                    docker rm -f live-poll-%TARGET_ENV% >nul 2>&1
                    docker run -d --name live-poll-%TARGET_ENV% --restart unless-stopped -p %HOST_PORT%:3000 -e APP_ENV=%APP_ENV% -e LOG_LEVEL=%LOG_LEVEL% -e "POLL_QUESTION=%POLL_QUESTION%" -e "POLL_OPTIONS=%POLL_OPTIONS%" -e ADMIN_TOKEN %IMAGE%:%BUILD_NUMBER%
                '''
            }
        }
    }

    post {
        always  { bat returnStatus: true, script: 'docker logout & docker image prune -f' }
        success { echo "Live Poll build #${env.BUILD_NUMBER} deployed to ${params.TARGET_ENV} on port ${env.HOST_PORT}" }
        failure { echo "Build #${env.BUILD_NUMBER} failed" }
    }
}
